# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored – never commit your token.

# Token from Accord Fintech (the sample token they emailed works for date 31072026)
ACCORD_TOKEN=your_token_here

# Base endpoint (only change if Accord gives you a new URL)
ACCORD_BASE_URL=https://contentapi.accordwebservices.com/RawData/GetRawDataJSON

# true  = serve made-up sample data (use this until your IP is whitelisted)
# false = call Accord for real
ACCORD_MOCK=false

# How long to wait for Accord before giving up (ms)
ACCORD_TIMEOUT_MS=60000

# Date the UI opens on (ddmmyyyy). 31072026 is the sample date Accord gave.
NEXT_PUBLIC_DEFAULT_DATE=31072026
